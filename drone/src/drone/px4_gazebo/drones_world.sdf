<sdf version='1.9'>
  <world name='default'>
    <!-- Physics properties -->
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>

    <!-- Plugins related to simulation -->
    <plugin name='gz::sim::systems::Physics' filename='gz-sim-physics-system'/>
    <plugin name='gz::sim::systems::UserCommands' filename='gz-sim-user-commands-system'/>
    <plugin name='gz::sim::systems::SceneBroadcaster' filename='gz-sim-scene-broadcaster-system'/>
    <plugin name='gz::sim::systems::Contact' filename='gz-sim-contact-system'/>
    <plugin name='gz::sim::systems::Imu' filename='gz-sim-imu-system'/>
    <plugin name='gz::sim::systems::AirPressure' filename='gz-sim-air-pressure-system'/>
    <plugin name='gz::sim::systems::ApplyLinkWrench' filename='gz-sim-apply-link-wrench-system'/>
    <plugin name='gz::sim::systems::Sensors' filename='gz-sim-sensors-system'>
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- PX4-specific plugins: ensures PX4 receives sensor data -->
    <plugin name="gazebo_mavlink_interface" filename="libgazebo_mavlink_interface.so">
      <robotNamespace/>
      <enable_groundtruth>false</enable_groundtruth>
      <use_mavlink>true</use_mavlink>
      <mavlink_addr>192.168.1.1</mavlink_addr> <!-- Ensure this matches your relay IP -->
      <mavlink_udp_port>14560</mavlink_udp_port>
      <imu_sub_topic>/imu/data</imu_sub_topic>
      <gps_sub_topic>/gps</gps_sub_topic>
      <mag_sub_topic>/mag/data</mag_sub_topic>
      <baro_sub_topic>/baro/data</baro_sub_topic>
      <airspeed_sub_topic>/airspeed</airspeed_sub_topic>
      <modelName/>
      <network_address>AUTO</network_address>
    </plugin>

    <!-- Individual sensor plugins -->
    <plugin name="imu_sensor_plugin" filename="libgazebo_imu_plugin.so">
      <topic>/imu/data</topic>
    </plugin>
    <plugin name="gps_sensor_plugin" filename="libgazebo_gps_plugin.so">
      <topic>/gps</topic>
    </plugin>
    <plugin name="magnetometer_sensor_plugin" filename="libgazebo_magnetometer_plugin.so">
      <topic>/mag/data</topic>
    </plugin>
    <plugin name="barometer_sensor_plugin" filename="libgazebo_barometer_plugin.so">
      <topic>/baro/data</topic>
    </plugin>

    <!-- GUI configuration -->
    <gui fullscreen='false'>
      <plugin name='3D View' filename='GzScene3D'>
        <gz-gui>
          <title>3D View</title>
          <property type='bool' key='showTitleBar'>0</property>
          <property type='string' key='state'>docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.5984631152222222 0.5984631152222222 0.5984631152222222</ambient_light>
        <background_color>0.8984631152222222 0.8984631152222222 0.8984631152222222</background_color>
        <camera_pose>278.08 -138.22 10 0.02 1 -0.65</camera_pose>
      </plugin>
      <plugin name='World control' filename='WorldControl'>
        <gz-gui>
          <title>World control</title>
          <property type='bool' key='showTitleBar'>0</property>
          <property type='bool' key='resizable'>0</property>
          <property type='double' key='height'>72</property>
          <property type='double' key='width'>121</property>
          <property type='double' key='z'>1</property>
          <property type='string' key='state'>floating</property>
          <anchors target='3D View'>
            <line own='left' target='left'/>
            <line own='bottom' target='bottom'/>
          </anchors>
        </gz-gui>
        <play_pause>1</play_pause>
        <step>1</step>
        <start_paused>1</start_paused>
      </plugin>
      <plugin name='World stats' filename='WorldStats'>
        <gz-gui>
          <title>World stats</title>
          <property type='bool' key='showTitleBar'>0</property>
          <property type='bool' key='resizable'>0</property>
          <property type='double' key='height'>110</property>
          <property type='double' key='width'>290</property>
          <property type='double' key='z'>1</property>
          <property type='string' key='state'>floating</property>
          <anchors target='3D View'>
            <line own='right' target='right'/>
            <line own='bottom' target='bottom'/>
          </anchors>
        </gz-gui>
        <sim_time>1</sim_time>
        <real_time>1</real_time>
        <real_time_factor>1</real_time_factor>
        <iterations>1</iterations>
      </plugin>
      <plugin name='Entity tree' filename='EntityTree'/>
    </gui>

    <!-- Global properties -->
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type='adiabatic'/>

    <!-- Scene properties -->
    <scene>
      <grid>false</grid>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- Example of ground plane model -->
    <model name='ground_plane'>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1 1</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode/>
            </friction>
            <bounce/>
            <contact/>
          </surface>
        </collision>
        <visual name='visual'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
            <material>
              <ambient>0.8 0.8 0.8 1</ambient>
              <diffuse>0.8 0.8 0.8 1</diffuse>
              <specular>0.8 0.8 0.8 1</specular>
            </material>
          </geometry>
          <pose>0 0 0 0 -0 0</pose>
          <inertial>
            <pose>0 0 0 0 -0 0</pose>
            <mass>1</mass>
            <inertia>
              <ixx>1</ixx>
              <ixy>0</ixy>
              <ixz>0</ixz>
              <iyy>1</iyy>
              <iyz>0</iyz>
              <izz>1</izz>
            </inertia>
          </inertial>
          <enable_wind>false</enable_wind>
        </visual>
      </link>
      <pose>0 0 0 0 -0 0</pose>
      <self_collide>false</self_collide>
    </model>

    <!-- Example light configuration -->
    <light name='sunUTC' type='directional'>
      <pose>0 0 500 0 -0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>0.001 0.625 -0.78</direction>
      <diffuse>0.904 0.904 0.904 1</diffuse>
      <specular>0.271 0.271 0.271 1</specular>
      <attenuation>
        <range>2000</range>
        <linear>0</linear>
        <constant>1</constant>
        <quadratic>0</quadratic>
      </attenuation>
      <spot>
        <outer_angle>0</outer_angle>
        <falloff>0</falloff>
      </spot>
    </light>

    <!-- Include other models just like the examples given -->
    <include>
      <uri>model://sonoma_raceway</uri>
    </include>
    <include>
      <pose>285.24 -146.97 2.57 0.02 0 -0.65</pose>
      <uri>model://hatchback_blue</uri>
      <name>hatchback_blue_1</name>
    </include>
    <include>
      <pose>273.43 -137.65 2.86 0.02 0 -0.65</pose>
      <uri>model://pickup</uri>
      <name>pickup_1</name>
    </include>
    <include>
      <pose>295.96 -146.5 2.48 -0.019 -0.008 2.46</pose>
      <uri>model://pickup</uri>
      <name>pickup_2</name>
    </include>
    <include>
      <pose>280.64 -137.32 2.77 -0.019 -0.008 2.46</pose>
      <uri>model://casual_female</uri>
    </include>

    <!-- PX4 model inclusion -->
    <include>
      <pose>268.08 -128.22 3.86 0.00 0 -0.70</pose>
      <uri>model://gz_x500</uri>
    </include>

  </world>
</sdf>
