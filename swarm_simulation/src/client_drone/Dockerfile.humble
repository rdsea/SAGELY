WORKDIR /root/drone/src/object_classification/client_drone

ENV PROTOCOL_BUFFERS_PYTHON_IMPLEMENTATION=python

# Define entry point
#CMD ["tmuxinator", "start", "px4_ros2_gazebo_gcs"]
ENTRYPOINT ["/bin/bash", "-c"]

